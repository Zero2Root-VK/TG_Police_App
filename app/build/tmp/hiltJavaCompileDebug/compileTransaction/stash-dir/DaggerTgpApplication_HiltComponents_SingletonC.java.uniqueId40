          return (T) new AppwriteAuthRepository(singletonCImpl.provideAccountClientProvider.get(), singletonCImpl.defaultSessionRepositoryProvider.get());

          case 6: // com.tgp.mockexam.core.network.AccountClient
          return (T) DataModule_Companion_ProvideAccountClientFactory.provideAccountClient(singletonCImpl.provideAppwriteConfigProvider.get());

          case 7: // com.tgp.mockexam.core.datastore.DefaultSessionRepository
