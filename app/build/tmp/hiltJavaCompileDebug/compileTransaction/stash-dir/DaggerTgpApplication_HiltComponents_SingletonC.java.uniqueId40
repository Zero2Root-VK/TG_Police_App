          return (T) new CachedPaperRepository(singletonCImpl.assetPaperRepositoryProvider.get(), singletonCImpl.contentDao(), singletonCImpl.appwriteContentSyncerProvider.get(), singletonCImpl.provideDispatcherProvider.get());

